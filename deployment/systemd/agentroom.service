[Unit]
Description=AgentRoom Room Server
Documentation=https://github.com/wwppyicn21/agent-room
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentroom
Group=agentroom
WorkingDirectory=/opt/agentroom/current
EnvironmentFile=/etc/agentroom/agentroom.env
ExecStart=/opt/node/bin/node apps/server/dist/main.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agentroom
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
