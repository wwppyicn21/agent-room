# Cloudflare Tunnel for Agent Room. Run cloudflared as the `cloudflared` user.
tunnel: REPLACE-WITH-TUNNEL-UUID
credentials-file: /etc/cloudflared/REPLACE-WITH-TUNNEL-UUID.json

ingress:
  - hostname: room.example.com
    service: http://127.0.0.1:8787
  - hostname: agent.example.com
    service: http://127.0.0.1:8787
  - service: http_status:404
