{
  "name": "@room/dsh-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Room DSH plugin: bridge Room groups to explicitly mapped DSH sessions",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@room/agent-sdk": "workspace:*",
    "@room/config": "workspace:*",
    "esbuild": "^0.27.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT"
}
