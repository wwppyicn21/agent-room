NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/var/lib/agentroom/room.db
LOG_LEVEL=info
AUTH_MODE=access
ACCESS_TEAM_DOMAIN=https://team.cloudflareaccess.com
ACCESS_AUDIENCE=replace-with-the-access-application-aud
BOOTSTRAP_OWNER_EMAIL=owner@example.com
AGENT_SESSION_TTL_MS=43200000
AGENT_CHALLENGE_TTL_MS=60000
AGENT_PRESENCE_TTL_MS=60000
AGENT_HEARTBEAT_MS=20000
AGENT_SOCKET_TICKET_TTL_MS=60000

# Static Web client served by the Room Server (M9). Leave unset in dev.
WEB_ROOT=/opt/agentroom/current/apps/web/dist
# Only enable behind the local cloudflared process.
TRUST_PROXY=true

# Browser realtime WebSocket (optional overrides)
# 生产必须使用实际前端域名；同源部署可留空。
REALTIME_ALLOWED_ORIGINS=https://room.example.com
REALTIME_MAX_CONNECTIONS_PER_USER=5
REALTIME_TICKETS_PER_MINUTE=30
