NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=/var/lib/agentroom/room.db
LOG_LEVEL=info
AUTH_MODE=access
ACCESS_TEAM_DOMAIN=https://team.cloudflareaccess.com
ACCESS_AUDIENCE=replace-with-the-access-application-aud
BOOTSTRAP_OWNER_EMAIL=owner@example.com
AGENT_SESSION_TTL_MS=43200000
AGENT_CHALLENGE_TTL_MS=60000
AGENT_PRESENCE_TTL_MS=60000
AGENT_HEARTBEAT_MS=20000
# M4 风控完成前保持 false；生产环境禁止开启。
AGENT_MESSAGES_ENABLED=false
AGENT_SOCKET_TICKET_TTL_MS=60000
